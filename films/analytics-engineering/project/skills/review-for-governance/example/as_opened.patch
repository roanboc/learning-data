+# The Faculty of Health's conceptual model: the question it asks, and the one concept it adds.
+#
+# Not parsed by dbt (.dbtignore). scripts/generate/definitions.py turns each definition into a doc
+# block in _health__definitions.md, next to this file.
+
+domain: health
+kind: mart
+
+question:
+  asked_by: Faculty of Health
+  text: >
+    Which of the faculty's learners have the most still to do for their award, so the advisers can
+    call them first?
+  decision: >
+    Who the faculty's student advisers call each week.
+
+uses: [learner, award, credit_towards_award]
+
+entities:
+
+  - name: learner_progress
+    label: learner progress
+    definition: >
+      How far a learner studying for one of the faculty's awards is from finishing it: the credit
+      points the award requires, the points they've earned, and the points still to go.
+    owner: Faculty of Health
+    business_key:
+      rule: The learner's business key and the award's, together.
+    rules:
+      - Only the faculty's own awards (faculty code HLT).
+    history: Today only. Last week's list isn't kept.
