diff --git a/films/analytics-engineering/project/models/marts/health/mart_health__learner_progress.sql b/films/analytics-engineering/project/models/marts/health/mart_health__learner_progress.sql
new file mode 100644
index 0000000..8fffc84
--- /dev/null
+++ b/films/analytics-engineering/project/models/marts/health/mart_health__learner_progress.sql
@@ -0,0 +1,59 @@
+with
+
+learners as (
+
+    select * from {{ ref('core_learner') }}
+
+),
+
+awards as (
+
+    select * from {{ ref('core_award') }}
+
+),
+
+credit as (
+
+    select * from {{ ref('core_credit_towards_award') }}
+
+),
+
+-- as it is now: each entity's version valid today
+current_learners as (
+
+    select * from learners where {{ valid_at(as_is_date()) }}
+
+),
+
+current_awards as (
+
+    select * from awards where {{ valid_at(as_is_date()) }}
+
+),
+
+current_credit as (
+
+    select * from credit where {{ valid_at(as_is_date()) }}
+
+)
+
+-- the faculty's learners studying today, in the award they're enrolled in
+select
+    current_learners.learner_key,
+    current_learners.full_name,
+    current_learners.email,
+    current_awards.award_key,
+    current_awards.award_code,
+    current_awards.award_name,
+    current_awards.faculty_code,
+    current_awards.credit_points_required,
+    coalesce(current_credit.credit_points_earned, 0) as credit_points_earned,
+    greatest(current_awards.credit_points_required - coalesce(current_credit.credit_points_earned, 0), 0)
+        as credit_points_remaining
+from current_learners
+inner join current_awards on current_awards.award_key = current_learners.enrolled_award_key
+left join current_credit
+    on current_credit.learner_key = current_learners.learner_key
+    and current_credit.award_key = current_learners.enrolled_award_key
+where current_learners.status = 'studying'
+    and current_awards.faculty_code = 'HLT'
