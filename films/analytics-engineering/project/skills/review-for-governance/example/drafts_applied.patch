+# Generated by scripts/generate/products.py from products/health_learner_progress.yml and the dbt contracts. Don't edit it:
+# change those, then run the script. CI fails if it's out of date.
+apiVersion: v3.1.0
+kind: DataContract
+id: 68b05427-fc24-536a-8420-c16040529fe4
+name: mart_health__learner_progress
+version: 1.0.0
+status: active
+domain: health
+dataProduct: health_learner_progress
+description:
+  purpose: Every learner studying for one of the faculty's awards today, and how far each is from finishing
+    it.
+  usage: For the faculty's student advisers, who call first the learners with the most still to do.
+schema:
+- name: mart_health__learner_progress
+  physicalName: mart_health__learner_progress
+  logicalType: object
+  physicalType: table
+  description: 'Every learner studying for one of the Faculty of Health''s awards today, and how far they
+    are from finishing it, with their name and email: the faculty''s advisers call them.'
+  properties:
+  - name: learner_key
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: pseudonymous
+    description: 'The learner''s hash key: the sha-256 of `learner_bk`, as 64 hex characters. The same
+      learner has the same key in every model, on every engine.'
+  - name: full_name
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: direct
+    description: The learner's name, now.
+  - name: email
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: direct
+    description: The learner's email, now.
+  - name: award_key
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: none
+    description: 'The award''s hash key: the sha-256 of `award_bk`.'
+  - name: award_code
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: none
+    description: The registrar's code for the award, like `GCDA`.
+  - name: award_name
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: none
+    description: The award's name.
+  - name: faculty_code
+    logicalType: string
+    physicalType: string
+    required: false
+    classification: none
+    description: The code of the faculty that offers the award, like `EIT`.
+    quality:
+    - id: accepted_values_mart_health__learner_progress_faculty_code__HLT
+      metric: invalidValues
+      mustBe: 0
+      unit: rows
+      arguments:
+        validValues:
+        - HLT
+      dimension: conformity
+      severity: error
+  - name: credit_points_required
+    logicalType: integer
+    physicalType: int
+    required: false
+    classification: none
+    description: The credit points the award requires, as the student system holds it.
+  - name: credit_points_earned
+    logicalType: integer
+    physicalType: int
+    required: false
+    classification: none
+    description: Credit points from units and microcredentials that count towards the award, under the
+      rule in the credit towards an award definition. Now, towards the award the learner is enrolled in.
+  - name: credit_points_remaining
+    logicalType: integer
+    physicalType: int
+    required: false
+    classification: none
+    description: 'Credit points still needed for the award: required minus earned, and never below zero.'
+slaProperties:
+- property: latency
+  value: 1
+  unit: d
+  description: Built every night.
+team:
+  name: Faculty of Health
+  members:
+  - username: health.data@uni.example
+    name: Faculty of Health
+    role: owner
+support:
+- channel: health-data
+  tool: email
+  url: mailto:health.data@uni.example
+  scope: issues
+customProperties:
+- property: grain
+  value: One row per learner studying for one of the faculty's awards, today
+- property: dbtModel
+  value: mart_health__learner_progress
+- property: consumers
+  value: []
