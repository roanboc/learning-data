diff --git a/films/analytics-engineering/project/models/marts/planning/mart_planning__completions.sql b/films/analytics-engineering/project/models/marts/planning/mart_planning__completions.sql
new file mode 100644
index 00000000..c0602e87
--- /dev/null
+++ b/films/analytics-engineering/project/models/marts/planning/mart_planning__completions.sql
@@ -0,0 +1,38 @@
+-- The awards conferred in the census year, by faculty and award type: Planning's completions, for
+-- its census report. It reads only the core's public models.
+with
+
+credentials as (
+
+    select * from {{ ref('core_credential', v=2) }}
+
+),
+
+awards as (
+
+    select * from {{ ref('core_award') }}
+    where is_current
+
+),
+
+conferred as (
+
+    select
+        awards.faculty_code,
+        awards.faculty_name,
+        awards.award_type
+    from credentials
+    inner join awards on credentials.credential_code = awards.award_code
+    where credentials.credential_kind = 'award'
+        and credentials.status != 'revoked'
+        and extract(year from credentials.issued_on) = extract(year from {{ census_date() }})
+
+)
+
+select
+    faculty_code,
+    faculty_name,
+    award_type,
+    cast(count(*) as int) as awards_conferred
+from conferred
+group by faculty_code, faculty_name, award_type
