{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py session-start", "timeout": 10}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py pre-bash", "timeout": 10}]},
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py pre-edit", "timeout": 10}]},
      {"matcher": "Read", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py pre-read", "timeout": 10}]},
      {"matcher": "mcp__.*github.*__(merge_pull_request|actions_run_trigger|run_workflow)", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py pre-merge", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py post-edit", "timeout": 20}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python \"$CLAUDE_PROJECT_DIR\"/.github/hooks/guard.py stop", "timeout": 15}]}
    ]
  }
}
